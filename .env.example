# Server-only AI routing. Hybrid sends routine tasks to DeepSeek and complex tasks to Gemini.
AI_PROVIDER=hybrid
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.7-flash
DEEPSEEK_API_KEY=
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional fallback provider. This is disabled unless explicitly set to true.
AI_ENABLE_OPENROUTER_FALLBACK=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Server-only OKX Onchain OS Open API configuration
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# Public project configuration (Reown is required for wallet connections)
NEXT_PUBLIC_XLAYER_BUILDER_CODE=
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Neon Postgres (pooled connection string recommended for the app runtime)
DATABASE_URL=
